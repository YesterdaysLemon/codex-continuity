<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>CodexContinuity.Tray</AssemblyName>
    <RootNamespace>CodexContinuity.Tray</RootNamespace>
    <Version>0.7.0</Version>
    <Authors>YesterdaysLemon</Authors>
    <Company>YesterdaysLemon</Company>
    <Product>Codex Continuity</Product>
    <AssemblyTitle>Codex Continuity Tray</AssemblyTitle>
    <Copyright>Copyright © 2026 Alireza Afshan</Copyright>
    <Description>Optional notification-area status for Codex Continuity.</Description>
    <RepositoryUrl>https://github.com/YesterdaysLemon/codex-continuity</RepositoryUrl>
    <ApplicationIcon>..\assets\CodexContinuity.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\UpdateContracts.cs" Link="UpdateContracts.cs" />
    <Compile Include="..\PackageIdentity.cs" Link="PackageIdentity.cs" />
  </ItemGroup>
</Project>
