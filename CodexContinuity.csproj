<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>CodexContinuity</AssemblyName>
    <RootNamespace>CodexContinuity</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>YesterdaysLemon</Authors>
    <Product>Codex Continuity</Product>
    <Description>Keep Codex agent threads alive while the Windows desktop UI updates or restarts.</Description>
    <RepositoryUrl>https://github.com/YesterdaysLemon/codex-continuity</RepositoryUrl>
  </PropertyGroup>
</Project>
